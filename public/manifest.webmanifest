{
  "name": "Methyl",
  "short_name": "Methyl",
  "description": "Self-hostable offline-first Markdown vault",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "orientation": "any",
  "categories": ["productivity"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New note",
      "url": "/?action=new",
      "description": "Create a new note"
    },
    {
      "name": "Search",
      "url": "/?action=search",
      "description": "Search the vault"
    },
    {
      "name": "New graph",
      "url": "/?action=new-graph",
      "description": "Create a new graph note"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["text/markdown", ".md", "text/plain"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/?action=open-file",
      "accept": {
        "text/markdown": [".md", ".markdown"]
      }
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/screenshots/narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ]
}
