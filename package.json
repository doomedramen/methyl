{
  "name": "adhd",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -p none 'serwist build --watch' 'next dev'",
    "build": "next build && serwist build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/server.cjs --external:better-sqlite3 --external:loro-crdt --external:loro-websocket --external:loro-protocol --external:chokidar --external:next --alias:@=./src",
    "start": "next start",
    "start:server": "node dist/server.cjs",
    "lint": "eslint",
    "check:type": "tsc --noEmit",
    "check:unit": "vitest run --maxWorkers=4",
    "check:e2e": "playwright test --workers=2",
    "check:ci": "npm run check:type && npm run check:unit && npm run check:e2e",
    "check:docker": "docker buildx build --platform linux/amd64 --load --tag methyl:hook-check .",
    "test": "npm run check:unit",
    "test:watch": "vitest",
    "test:e2e": "npm run check:e2e",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "node -e \"if(require('fs').existsSync('.git'))require('child_process').execSync('lefthook install',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@loro-dev/flock": "^4.5.1",
    "@noble/hashes": "^2.4.0",
    "@shadcn/react": "^0.3.1",
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.5.0",
    "loro-adaptors": "0.6.1",
    "loro-codemirror": "^0.3.3",
    "loro-crdt": "^1.16.1",
    "loro-protocol": "0.3.0",
    "loro-websocket": "^0.6.2",
    "lucide-react": "^1.46.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mermaid": "^12.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "minisearch": "^7.2.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@serwist/build": "^9.5.12",
    "@serwist/cli": "^9.5.12",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "lefthook": "^2.1.14",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
